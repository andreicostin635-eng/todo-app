# Берём официальный образ Node.js версии 18 (LTS — долгосрочная поддержка)
FROM node:18

# Создаём рабочую папку внутри контейнера
# Все последующие команды будут выполняться отсюда
WORKDIR /app

# Сначала копируем ТОЛЬКО package.json
# Это нужно для оптимизации: Docker кэширует слои,
# и если код изменился, но зависимости те же — не будет переустанавливать npm пакеты
COPY package.json .

# Устанавливаем все зависимости из package.json
RUN npm install

# Теперь копируем весь остальной код
COPY . .

# Говорим Docker, что контейнер будет слушать порт 3000
# (это только документация, реально порт открывается при запуске)
EXPOSE 3000

# Команда, которая запустится когда контейнер стартует
CMD ["node", "index.js"]